# 管理页口令。公网部署必须设置，随便生成一个长随机串。
GATEWAY_ADMIN_TOKEN=change-me

# Semifly customer platform. Set these exactly once on first deployment to
# bootstrap the owner account; remove both bootstrap values from the runtime
# environment after that account exists. Browser sessions are Secure cookies.
SEMIFLY_ADMIN_EMAIL=admin@example.com
SEMIFLY_ADMIN_PASSWORD=replace-with-a-unique-12-plus-character-password
SEMIFLY_COOKIE_SECURE=1
SEMIFLY_REQUIRE_VERIFIED_EMAIL=1
SEMIFLY_PUBLIC_BASE_URL=https://api.semifly.ai

# Required for verified registration and password reset in production. Use a
# transactional email account over STARTTLS; these credentials stay server-side.
SEMIFLY_SMTP_HOST=
SEMIFLY_SMTP_PORT=587
SEMIFLY_SMTP_USERNAME=
SEMIFLY_SMTP_PASSWORD=
SEMIFLY_EMAIL_FROM=security@semifly.ai

# Stripe is the payment processor. Values come from the Stripe dashboard and
# must stay on the server; never expose them in the browser or repository.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 上游真实 Key，只存在这台机器上，永远不发给客户。
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
